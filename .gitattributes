# Archivos de texto: siempre guardar como LF en el repositorio
* text=auto eol=lf

# Archivos específicos que NO deben cambiar su EOL nunca
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.java text eol=lf
*.md text eol=lf

# Archivos binarios (Git no los debe tocar nunca)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.jar binary
*.zip binary
*.class binary
